{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the ChessVerse application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "username": {
          "type": "string",
          "description": "User's display name."
        },
        "eloRating": {
          "type": "number",
          "description": "The user's ELO rating. Defaults to 1200."
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Number of games completed by the user."
        },
        "wins": {
          "type": "number",
          "description": "Number of games won by the user."
        },
        "losses": {
          "type": "number",
          "description": "Number of games lost by the user."
        },
        "draws": {
          "type": "number",
          "description": "Number of games drawn by the user."
        },
        "onlineStatus": {
          "type": "string",
          "enum": ["online", "offline"],
          "description": "The user's current presence status."
        }
      },
      "required": [
        "id",
        "email",
        "username"
      ]
    },
    "Game": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Game",
      "type": "object",
      "description": "Represents a chess game.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the game."
        },
        "player1Id": {
          "type": "string",
          "description": "Reference to User 1 (the inviter)."
        },
        "player2Id": {
          "type": "string",
          "description": "Reference to User 2 (the invited player)."
        },
        "player1": { "$ref": "#/entities/User" },
        "player2": { "$ref": "#/entities/User" },
        "startTime": {
          "type": "string",
          "description": "Timestamp indicating the start time of the game.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "Timestamp indicating the end time of the game.",
          "format": "date-time"
        },
        "moves": {
          "type": "array",
          "description": "List of chess moves in the game.",
          "items": {
            "type": "string"
          }
        },
        "winnerId": {
          "type": "string",
          "description": "Reference to User who won the game. Null if the game is still ongoing or it was a draw."
        },
        "fen": {
          "type": "string",
          "description": "The board state in Forsyth-Edwards Notation."
        },
        "turn": {
          "type": "string",
          "enum": [
            "w",
            "b"
          ],
          "description": "The current player's turn ('w' for white, 'b' for black)."
        },
        "status": {
          "type": "string",
          "enum": ["invited", "waiting", "inprogress", "completed"],
          "description": "The current status of the game."
        },
        "timeControl": {
          "type": "object",
          "description": "Time control settings for the game.",
          "properties": {
            "initial": {
              "type": "number",
              "description": "Initial time for each player in seconds."
            },
            "increment": {
              "type": "number",
              "description": "Time increment per move in seconds."
            }
          }
        },
        "isTournamentGame": {
          "type": "boolean",
          "description": "Flag indicating if the game is part of a tournament."
        },
        "tournamentId": {
          "type": "string",
          "description": "ID of the tournament this game belongs to."
        }
      },
      "required": [
        "id",
        "player1Id",
        "player2Id",
        "status",
        "fen",
        "turn"
      ]
    },
    "TimeControl": {
      "title": "Time Control",
      "type": "object",
      "description": "Time control settings for a game.",
      "properties": {
        "initial": {
          "type": "number",
          "description": "Initial time for each player in milliseconds."
        },
        "increment": {
          "type": "number",
          "description": "Time increment per move in milliseconds."
        }
      },
      "required": ["initial", "increment"]
    },
    "Tournament": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tournament",
      "type": "object",
      "description": "Represents a chess tournament.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the tournament."
        },
        "name": {
          "type": "string",
          "description": "Name of the tournament."
        },
        "timeControl": {
          "$ref": "#/entities/TimeControl"
        },
        "entryFee": {
          "type": "number",
          "description": "Entry fee for the tournament."
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp for when the tournament registration locks and it prepares to start."
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration of the tournament in minutes after it goes live."
        },
        "maxPlayers": {
          "type": "number",
          "description": "Maximum number of players that can join."
        },
        "playerCount": {
          "type": "number",
          "description": "Current number of players registered."
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "locked",
            "live",
            "completed",
            "archived"
          ],
          "description": "The current state of the tournament."
        },
        "liveSince": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp for when the tournament went live and games began."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the tournament was created."
        },
        "finalStandings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Final rankings of players."
        }
      },
      "required": [
        "id",
        "name",
        "timeControl",
        "startTime",
        "durationMinutes",
        "maxPlayers",
        "playerCount",
        "state",
        "createdAt"
      ]
    },
    "TournamentPlayer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TournamentPlayer",
      "type": "object",
      "description": "Represents a player's state within a tournament.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's ID."
        },
        "username": {
          "type": "string"
        },
        "eloRating": {
          "type": "number"
        },
        "score": {
          "type": "number",
          "description": "Player's current score in the tournament."
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Number of games played in the tournament."
        },
        "activeGameId": {
          "type": [
            "string",
            "null"
          ],
          "description": "ID of the active game, if any."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the player joined."
        }
      },
      "required": [
        "uid",
        "username",
        "score",
        "gamesPlayed",
        "joinedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. Access control is based on path-based ownership.  A user can only access their own document.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/games/{gameId}",
        "definition": {
          "entityName": "Game",
          "schema": {
            "$ref": "#/backend/entities/Game"
          },
          "description": "Stores game state. It is publicly readable but can only be modified by players in the game.",
          "params": [
            {
              "name": "gameId",
              "description": "The unique identifier for the game."
            }
          ]
        }
      },
      {
        "path": "/tournaments/{tournamentId}",
        "definition": {
          "entityName": "Tournament",
          "schema": {
            "$ref": "#/backend/entities/Tournament"
          },
          "description": "Stores tournament information.",
          "params": [
            {
              "name": "tournamentId",
              "description": "The unique identifier for the tournament."
            }
          ]
        }
      },
      {
        "path": "/tournaments/{tournamentId}/players/{playerId}",
        "definition": {
          "entityName": "TournamentPlayer",
          "schema": {
            "$ref": "#/backend/entities/TournamentPlayer"
          },
          "description": "Stores individual player data within a tournament.",
          "params": [
            {
              "name": "tournamentId",
              "description": "The unique identifier for the tournament."
            },
            {
              "name": "playerId",
              "description": "The user's unique ID."
            }
          ]
        }
      }
    ]
  }
}

    