/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for user-specific data,
 * while allowing public read access for shared game data to enable a lobby system.
 *
 * Data Structure:
 * - `/users/{userId}`: Private data tree for each user, accessible only by the owner.
 * - `/games/{gameId}`: Publicly listable and readable collection for game states.
 *   Write access is restricted to the players involved in the game.
 *
 * Key Security Decisions:
 * - User Listing Disabled: To protect user privacy, listing all users is forbidden.
 * - Path-Based Ownership: Access to any document under `/users/{userId}` is granted only
 *   if the requester's UID matches the `{userId}` in the path.
 * - Public Game Lobby: The `/games` collection is readable by any authenticated user to
 *   populate the game lobby.
 * - Restricted Game Writes: Only the players participating in a game can update its state.
 *   This prevents cheating or griefing by outside users.
 * - Default Deny: All operations are denied by default unless explicitly permitted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * isPlayer
     * Checks if the requesting user is one of the two players in the game.
     */
    function isPlayer(gameResource) {
      return isSignedIn() && (request.auth.uid == gameResource.data.player1Id || request.auth.uid == gameResource.data.player2Id);
    }
    
    /**
     * isNewGameValid
     * Ensures required fields are present on game creation.
     */
    function isNewGameValid() {
      let data = request.resource.data;
      return data.player1Id == request.auth.uid
          && (data.status == 'waiting' || data.status == 'invited')
          && data.createdAt == request.time;
    }
    
    /**
     * isGameJoinValid
     * Validates a user joining an existing game.
     */
    function isGameJoinValid() {
      let before = resource.data;
      let after = request.resource.data;
      return (before.status == 'waiting' || before.status == 'invited')
          && after.status == 'inprogress'
          && before.player1Id != request.auth.uid // Can't join your own game
          && after.player2Id == request.auth.uid
          && before.keys().removeAll(['player2Id', 'player2', 'status']) == after.keys().removeAll(['player2Id', 'player2', 'status']);
    }

    /**
     * isGameUpdateValid
     * Validates an in-progress game update (e.g., making a move).
     */
     function isGameUpdateValid() {
        let before = resource.data;
        let after = request.resource.data;
        // Allow players to update the game state (fen, turn, moves, etc.)
        // but not to change the players or start time.
        return before.player1Id == after.player1Id 
          && before.player2Id == after.player2Id
          && before.startTime == after.startTime;
     }


    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Defines access control for user profile documents. A user can create,
     * read, and update their own profile, but cannot access anyone else's.
     * Listing all users is explicitly forbidden.
     */
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Deny deletion of user profiles.
    }

    /**
     * @description Defines access control for game documents. Games are publicly readable
     * to populate the lobby. Creating a game is allowed for any signed-in user.
     * Updating a game is restricted to the players in that game.
     */
    match /games/{gameId} {
      // Any authenticated user can read or list games for the lobby.
      allow read: if isSignedIn();
      
      // Any authenticated user can create a valid new game.
      allow create: if isSignedIn() && isNewGameValid();

      // Only players in the game can update it.
      allow update: if isSignedIn() && isPlayer(resource) && (isGameJoinValid() || isGameUpdateValid());
      
      // Only a player can delete a game they are in.
      allow delete: if isSignedIn() && isPlayer(resource);
    }
  }
}
