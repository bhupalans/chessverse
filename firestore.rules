/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All user-related data,
 * including profiles and game histories, is stored in a private data tree accessible only to the
 * authenticated owner. This ensures strong data isolation between users.
 *
 * Data Structure: The database is structured around a top-level `/users` collection. Each user's
 * data is nested under their unique user ID (`/users/{userId}`), creating a clear and secure
 * ownership hierarchy. Game data is stored in a subcollection (`/users/{userId}/games/{gameId}`),
 * further reinforcing this ownership model.
 *
 * Key Security Decisions:
 * - User Listing Disabled: To protect user privacy and prevent data scraping, it is not possible
 *   to query or list all documents in the top-level `/users` collection.
 * - Strict Path-Based Ownership: Access to any document under `/users/{userId}` is granted only
 *   if the requester's authenticated UID matches the `{userId}` in the path. This is the primary
 *   security mechanism.
 * - Default Deny: All operations are denied by default unless explicitly permitted by a rule.
 *
 * Denormalization for Authorization: The data structure inherently supports efficient authorization
 * by using the document path to denote ownership (e.g., `/users/{userId}`). This avoids the need
 * for slow and costly `get()` calls in security rules, as the owner's ID is always present in
 * the path of the resource being accessed.
 *
 * Structural Segregation: User-specific data (profiles, games) is segregated into dedicated
 * subcollections under each user's document. This is a secure and performant pattern that
 * simplifies rules for list operations, ensuring users can only query their own data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isExistingOwner
     * Combines an ownership check with a verification that the document
     * already exists. This is critical for secure update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ------------------------------------------------------------------------
    // Data Integrity Validation Helpers
    // ------------------------------------------------------------------------

    /**
     * isNewUserValid
     * Ensures that a new user document has an 'id' field that matches
     * the document's ID and the authenticated user's UID.
     */
    function isNewUserValid(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * isExistingUserValid
     * Enforces immutability of the 'id' field on user profile updates.
     */
    function isExistingUserValid() {
      return request.resource.data.id == resource.data.id;
    }
    
    /**
     * isNewGameValid
     * Ensures a new game document has an 'id' field matching its document ID.
     */
    function isNewGameValid(gameId) {
      return request.resource.data.id == gameId;
    }

    /**
     * isExistingGameValid
     * Enforces immutability of the 'id' field on game document updates.
     */
    function isExistingGameValid() {
      return request.resource.data.id == resource.data.id;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Defines access control for user profile documents. A user can create,
     * read, update, and delete their own profile, but cannot access anyone else's.
     * Listing all users is explicitly forbidden.
     * @path /users/{userId}
     * @allow (get) An authenticated user with UID 'user_abc' can read '/users/user_abc'.
     * @allow (create) An authenticated user with UID 'user_abc' can create '/users/user_abc' if the document data includes `id: 'user_abc'`.
     * @deny (get) A user with UID 'user_xyz' cannot read '/users/user_abc'.
     * @deny (list) No user can query the '/users' collection.
     * @principle Restricts access to a user's own data tree (Self-Creation & Ownership).
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isNewUserValid(userId);
      allow update: if isExistingOwner(userId) && isExistingUserValid();
      allow delete: if isExistingOwner(userId);

      // Deny listing of all user profiles for privacy and security.
      allow list: if false;
    }

    /**
     * @description Defines access control for game documents, which are stored in a subcollection
     * under the user who owns the record. A user can manage games within their
     * own subcollection but cannot see games belonging to other users.
     * @path /users/{userId}/games/{gameId}
     * @allow (list) An authenticated user with UID 'user_abc' can list all documents in '/users/user_abc/games'.
     * @allow (create) An authenticated user with UID 'user_abc' can create a new document in '/users/user_abc/games'.
     * @deny (get) A user with UID 'user_xyz' cannot read '/users/user_abc/games/game123'.
     * @deny (list) A user with UID 'user_xyz' cannot list documents in '/users/user_abc/games'.
     * @principle Enforces strict data ownership by scoping all game data within a user's private data tree.
     */
    match /users/{userId}/games/{gameId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isNewGameValid(gameId);
      allow update: if isExistingOwner(userId) && isExistingGameValid();
      allow delete: if isExistingOwner(userId);
    }
  }
}